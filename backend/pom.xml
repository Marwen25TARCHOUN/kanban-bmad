<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Project scaffolded via start.spring.io selections:
        Spring Boot 4.1.x (latest patch at scaffold time, 2026-11-21)
        Java 21 LTS
        Group: fr.marwen   (French-market TLD convention, portfolio-for-FR-interview signal)
        Artifact: kanban
        Deps: web, data-jpa, validation, actuator, h2 (runtime), lombok (provided)
      finalName=kanban pins the jar path for backend/Dockerfile.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.3</version>
        <relativePath/>
    </parent>

    <groupId>fr.marwen</groupId>
    <artifactId>kanban</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kanban</name>
    <description>Local AI-Augmented Kanban — backend</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Story 5 (AD-5 revised): Spring Boot 4.1 split the client-side HTTP machinery out of
          `spring-boot-starter-web` into a dedicated `spring-boot-starter-restclient`. It carries
          `spring-boot-http-client` which auto-configures `RestClient.Builder` with the Jackson 3
          message converters already in the context, and ships `ClientHttpRequestFactorySettings`
          for the per-call timeout wiring in `AnthropicRestClientConfig`. No WebClient / reactor /
          Anthropic-SDK deps — the single-shot direct call in `AiBreakdownService` is enough for
          the MVP (NFR-2 10 s p95, no retry per AD-5).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          Story 2 (AD-13 three-state PATCH): `JsonNullable<T>` lets the DTO distinguish
          "absent key" (ignore), "value" (update), and "null" (clear) in a PATCH body.
          Spring Boot auto-picks up any `com.fasterxml.jackson.databind.Module` bean, so
          CorsConfig registers `JsonNullableModule` once and Jackson handles the rest.
        -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.13</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring Boot 4.x split the web-MVC slice-test support into `spring-boot-webmvc-test`
          (new package: `org.springframework.boot.webmvc.test.autoconfigure`). It's not pulled in
          transitively by `spring-boot-starter-test`, so controller `@WebMvcTest`s need it added
          explicitly. Version is managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Patch D / I (review pass 1): `TestRestTemplate` moved in Spring Boot 4 from
          `org.springframework.boot.test.web.client` to `org.springframework.boot.resttestclient`,
          and the classes live in a new `spring-boot-resttestclient` module that isn't pulled in
          transitively. Needed for the `@SpringBootTest` integration tests that assert the
          CAP-7 404 contract and the aiEnabled-honesty invariant (patches F / A / I).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>kanban</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              Patch AA (review pass 1): fail the build if anyone pulls in WebClient / webflux
              or a retry library. AD-5 pins "RestClient only, no retry"; a CI-gated bannedDependencies
              rule turns a manual dependency-tree grep into a build-time guarantee.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ban-webflux-and-retry</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-webflux</exclude>
                                        <exclude>org.springframework:spring-webflux</exclude>
                                        <exclude>io.github.resilience4j:*</exclude>
                                        <exclude>org.springframework.retry:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
