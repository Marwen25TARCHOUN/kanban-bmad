# Anthropic API key — OPTIONAL (AD-6, FR-25).
#
# Copy this file to `.env` and paste your key below to enable the AI breakdown feature.
# Leave this file alone (or keep the key blank) and the app still starts — the AI bar
# simply hides and the board behaves as a plain Kanban.
#
# Get a key:  https://console.anthropic.com/settings/keys
#
ANTHROPIC_API_KEY=
